<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Magenheim</AssemblyName>
    <RootNamespace>Magenheim.Runtime</RootNamespace>
    <Version>0.0.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../Magenheim.Core/Magenheim.Core.csproj" />
    <PackageReference Include="JotunnLib" Version="2.30.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../default-data/foundation.json"
          Link="default-data/foundation.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
